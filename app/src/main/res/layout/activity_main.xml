<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="#FFFDF9">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jarvis"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#C5A44A"
            android:letterSpacing="0.15"
            android:layout_marginBottom="40dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="#C5A44A"
            android:visibility="gone"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona un modelo .gguf para empezar"
            android:textAlignment="center"
            android:textSize="15sp"
            android:textColor="#666"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/pickModelBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elegir modelo .gguf"
            android:backgroundTint="#C5A44A"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="32dp"
            android:paddingVertical="12dp" />

    </LinearLayout>

</FrameLayout>
